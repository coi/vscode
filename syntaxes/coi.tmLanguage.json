{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Coi",
  "scopeName": "source.coi",
  "patterns": [
    {
      "include": "#top"
    }
  ],
  "repository": {
    "top": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#import"
        },
        {
          "include": "#module"
        },
        {
          "include": "#view-block"
        },
        {
          "include": "#style-block"
        },
        {
          "include": "#router-block"
        },
        {
          "include": "#listen-block"
        },
        {
          "include": "#app-block"
        },
        {
          "include": "#lifecycle"
        },
        {
          "include": "#enum-block"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#signal"
        },
        {
          "include": "#emit"
        },
        {
          "include": "#block"
        },
        {
          "include": "#template-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#control-keywords"
        },
        {
          "include": "#modifiers"
        },
        {
          "include": "#types"
        },
        {
          "include": "#namespace-access"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#member-access"
        },
        {
          "include": "#type-names"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#expression-braces"
        }
      ]
    },
    "block": {
      "comment": "any { } in code: balanced, so nested ifs and loops never end a member early",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#top"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#template-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#control-keywords"
        },
        {
          "include": "#modifiers"
        },
        {
          "include": "#types"
        },
        {
          "include": "#namespace-access"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#member-access"
        },
        {
          "include": "#type-names"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#expression-braces"
        }
      ]
    },
    "expression-braces": {
      "comment": "pod literals and nested braces inside expressions",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.coi",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.coi"
            }
          }
        }
      ]
    },
    "annotation": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "0": {
          "name": "storage.type.annotation.coi"
        }
      }
    },
    "import": {
      "match": "\\b(import)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.import.coi"
        }
      }
    },
    "module": {
      "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.module.coi"
        },
        "2": {
          "name": "entity.name.namespace.coi"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.coi",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.coi"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.coi",
          "match": "\\\\."
        }
      ]
    },
    "template-string": {
      "name": "string.template.coi",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.coi"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.coi",
          "match": "\\\\."
        },
        {
          "name": "meta.template.expression.coi",
          "contentName": "meta.embedded.line.coi",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.coi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.coi"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.coi",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.coi",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.coi",
          "match": "\\b[0-9][0-9_]*(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.coi",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.coi",
          "match": "\\b(if|else|for|while|break|continue|return|yield|match|in)\\b"
        }
      ]
    },
    "modifiers": {
      "name": "storage.modifier.coi",
      "match": "\\b(mut|pub|shared)\\b"
    },
    "types": {
      "name": "storage.type.primitive.coi",
      "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|double|void|string|bool)\\b"
    },
    "type-names": {
      "comment": "capitalized names: pods, components, enums, handle types",
      "name": "entity.name.type.coi",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "namespace-access": {
      "patterns": [
        {
          "comment": "Module::fn(",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.coi"
            },
            "2": {
              "name": "punctuation.separator.namespace.coi"
            },
            "3": {
              "name": "entity.name.function.coi"
            }
          }
        },
        {
          "comment": "Module::Type and Enum::Member",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.coi"
            },
            "2": {
              "name": "punctuation.separator.namespace.coi"
            },
            "3": {
              "name": "variable.other.enummember.coi"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": ".method(",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.coi"
            },
            "2": {
              "name": "entity.name.function.member.coi"
            }
          }
        },
        {
          "comment": "fn(, not a keyword",
          "match": "\\b(?!(?:if|while|for|match|return|yield|def|signal|emit|component|pod|enum|tick)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.coi"
            }
          }
        }
      ]
    },
    "member-access": {
      "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.coi"
        },
        "2": {
          "name": "variable.other.property.coi"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.coi",
          "match": "=>"
        },
        {
          "name": "keyword.operator.move.coi",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.coi",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.compound.coi",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.logical.coi",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.reference.coi",
          "match": "&(?=[A-Za-z_(])"
        },
        {
          "name": "keyword.operator.bitwise.coi",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.coi",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.coi",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.coi",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.coi",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.colon.coi",
          "match": ":"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(component|pod|enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.coi"
            },
            "2": {
              "name": "entity.name.type.coi"
            }
          }
        },
        {
          "match": "\\b(component|pod|enum)\\b",
          "name": "storage.type.coi"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.coi"
            },
            "2": {
              "name": "entity.name.function.coi"
            }
          }
        },
        {
          "match": "\\bdef\\b",
          "name": "storage.type.function.coi"
        }
      ]
    },
    "signal": {
      "match": "\\b(signal)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.coi"
        },
        "2": {
          "name": "entity.name.function.coi"
        }
      }
    },
    "emit": {
      "match": "\\b(emit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.emit.coi"
        },
        "2": {
          "name": "entity.name.function.coi"
        }
      }
    },
    "lifecycle": {
      "comment": "member blocks; elsewhere these words are ordinary names",
      "match": "\\b(mount|init|tick)\\b(?=\\s*[({])",
      "captures": {
        "1": {
          "name": "keyword.other.lifecycle.coi"
        }
      }
    },
    "style-block": {
      "name": "meta.embedded.block.css",
      "begin": "\\b(style)\\s*(global\\b)?\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.style.coi"
        },
        "2": {
          "name": "storage.modifier.coi"
        },
        "3": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "router-block": {
      "begin": "\\b(router)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.router.coi"
        },
        "2": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#expression-braces"
        },
        {
          "include": "#type-names"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "listen-block": {
      "begin": "\\b(listen)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.listen.coi"
        },
        "2": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(=>)",
          "captures": {
            "1": {
              "name": "variable.other.object.coi"
            },
            "2": {
              "name": "punctuation.accessor.coi"
            },
            "3": {
              "name": "entity.name.function.coi"
            },
            "4": {
              "name": "keyword.operator.arrow.coi"
            }
          }
        },
        {
          "include": "#block"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "app-block": {
      "begin": "\\b(app)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.app.coi"
        },
        "2": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
          "captures": {
            "1": {
              "name": "variable.other.property.coi"
            }
          }
        },
        {
          "name": "constant.language.coi",
          "match": "\\b(always|demand)\\b"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "view-block": {
      "name": "meta.view.coi",
      "begin": "\\b(view)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.view.coi"
        },
        "2": {
          "name": "punctuation.definition.block.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#view-content"
        }
      ]
    },
    "view-content": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#view-member-ref"
        },
        {
          "include": "#view-control-tag"
        },
        {
          "include": "#view-close-tag"
        },
        {
          "include": "#view-tag"
        },
        {
          "include": "#view-interpolation"
        }
      ]
    },
    "view-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "contentName": "meta.embedded.expression.coi",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.coi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "view-close-tag": {
      "patterns": [
        {
          "match": "(</)\\s*(if|else|for|match|raw|route|slot)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "keyword.control.view.coi"
            },
            "3": {
              "name": "punctuation.definition.tag.end.coi"
            }
          }
        },
        {
          "match": "(</)\\s*([A-Z][A-Za-z0-9_]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "support.class.component.coi"
            },
            "3": {
              "name": "punctuation.definition.tag.end.coi"
            }
          }
        },
        {
          "match": "(</)\\s*([A-Za-z][A-Za-z0-9:-]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "entity.name.tag.coi"
            },
            "3": {
              "name": "punctuation.definition.tag.end.coi"
            }
          }
        }
      ]
    },
    "view-control-tag": {
      "comment": "<if cond>, <else>, <for x in xs key={...}>, <match ...>: the condition is a bare expression",
      "begin": "(<)(if|else|for|match)\\b",
      "end": "(/?>)(?!=)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.coi"
        },
        "2": {
          "name": "keyword.control.view.coi"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.coi"
        }
      },
      "patterns": [
        {
          "match": "\\b(key)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.control.key.coi"
            },
            "2": {
              "name": "keyword.operator.assignment.coi"
            }
          }
        },
        {
          "include": "#view-attribute-value"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#template-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#control-keywords"
        },
        {
          "include": "#namespace-access"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#member-access"
        },
        {
          "include": "#type-names"
        },
        {
          "name": "keyword.operator.coi",
          "match": "==|!=|<=|>=|&&|\\|\\||!|\\+|-|\\*|/|%|\\?|:|<"
        }
      ]
    },
    "view-member-ref": {
      "comment": "<{member} props />",
      "begin": "(<)\\s*(\\{)\\s*([^}]*)(\\})",
      "end": "(/?>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.coi"
        },
        "2": {
          "name": "punctuation.section.embedded.begin.coi"
        },
        "3": {
          "patterns": [
            {
              "include": "#expression"
            }
          ],
          "name": "support.class.component.member.coi"
        },
        "4": {
          "name": "punctuation.section.embedded.end.coi"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.coi"
        }
      },
      "patterns": [
        {
          "include": "#view-attributes"
        }
      ]
    },
    "view-tag": {
      "patterns": [
        {
          "begin": "(<)(raw|route|slot)\\b",
          "end": "(/?>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "keyword.control.view.coi"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.coi"
            }
          },
          "patterns": [
            {
              "include": "#view-attributes"
            }
          ]
        },
        {
          "begin": "(<)([A-Z][A-Za-z0-9_]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "support.class.component.coi"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.coi"
            }
          },
          "patterns": [
            {
              "include": "#view-attributes"
            }
          ]
        },
        {
          "begin": "(<)([A-Za-z][A-Za-z0-9:-]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.coi"
            },
            "2": {
              "name": "entity.name.tag.coi"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.coi"
            }
          },
          "patterns": [
            {
